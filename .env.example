# ============================================================================
# DASHA NEWS - example environment configuration
# Copy to ".env" and edit. NEVER commit the real .env.
# The application runs with ALL of these at their defaults (zero paid APIs).
# ============================================================================

# ---- Runtime ----
# "sqlite" (default, zero-config) or "postgresql"
DATABASE_KIND=sqlite
# Used only when DATABASE_KIND=postgresql
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dasha_news
# Comma-separated list of origins allowed by CORS (the Flutter app's origin(s))
CORS_ORIGINS=*

# ---- Server ----
HOST=0.0.0.0
PORT=8000
# Base URL used to build absolute media URLs
PUBLIC_BASE_URL=http://localhost:8000

# ---- Security ----
# Secret used to sign admin API keys / tokens. CHANGE THIS in production.
NEWSROOM_SECRET=change-me-to-a-long-random-string
# Admin API key for the newsroom console. Required to use /admin endpoints.
ADMIN_API_KEY=change-me-admin-key
# Maximum outbound fetch body size, in bytes (SSRF / abuse guard)
FETCH_MAX_BYTES=5242880
# Per-source request timeout, seconds
FETCH_TIMEOUT_SECONDS=20
# Anonymous API rate limit (requests / minute / IP)
RATE_LIMIT_PER_MINUTE=120

# ---- AI provider ----
# "heuristic" (default; fully deterministic, no external calls, $0)
# "ollama"   - local Ollama HTTP endpoint
# "openai"   - any OpenAI-compatible endpoint (OpenAI, Groq, Together, vLLM, ...)
AI_PROVIDER=heuristic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Leave blank when AI_PROVIDER=heuristic
OPENAI_API_KEY=

# ---- Newsroom automation ----
# Interval, in seconds, between automatic newsroom sweeps (ingest -> publish)
PIPELINE_INTERVAL_SECONDS=300
# Allow fully-automatic publishing for sufficiently supported stories
AUTO_PUBLISH_ENABLED=true
# Minimum evidence score a story needs to auto-publish
AUTO_PUBLISH_MIN_EVIDENCE=0.55
# Always require human approval for these sensitive categories
SENSITIVE_CATEGORIES_HOLD=crime,courts,accidents,unverified
# Days to keep articles before pruning raw HTML
RAW_RETENTION_DAYS=14

# ---- Media ----
# Directory for generated/cached media (audio, shorts, images)
MEDIA_DIR=backend/media
# Legal image sources to prefer (attribution metadata is always stored)
IMAGE_SOURCES=wikimedia,unsplash,pexels,generated

# ---- Audio (TTS) ----
# "espeak" (free, offline, Telugu-capable) or "none"
TTS_ENGINE=espeak
TTS_VOICE_TE=female
TTS_VOICE_EN=male
TTS_RATE=160

# ---- Notifications ----
# Notifier transport: "none" (in-app only) or "fcm"
NOTIFIER_TRANSPORT=none
FCM_SERVER_KEY=

# ---- Pexels / Unsplash (OPTIONAL; blank = fall back to Wikimedia/generated) ----
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
